# ---------------------------------------------------------------------------
# AppScout AI - environment variables
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# ---------------------------------------------------------------------------

# AI provider ---------------------------------------------------------------
#
# Two providers are supported. You only need a key for the one you use.
# Scraping works without any key at all - only the three AI stages need one.

# Google Gemini - the free-tier default. Get a key at:
#   https://aistudio.google.com/apikey    (no credit card required)
# SERVER ONLY - never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Anthropic Claude - better analyses, but billed per token against prepaid
# credits at console.anthropic.com. A Claude.ai subscription does NOT cover it.
# CLAUDE_API_KEY=

# Which provider runs the AI stages: gemini | anthropic
# Leave unset to auto-select: whichever key is present wins, Gemini first, so a
# server holding both keys never starts spending money by accident.
# AI_PROVIDER=gemini

# Optional overrides -------------------------------------------------------

# Model id, per provider.
# GEMINI_MODEL=gemini-3.6-flash
# CLAUDE_MODEL=claude-opus-5

# Reasoning depth: low | medium | high | xhigh | max
# Gemini maps these onto its four thinking levels (xhigh and max both = HIGH).
# AI_EFFORT=high

# Hard ceiling on competitors fetched in detail per research run (cost control).
# MAX_COMPETITOR_DETAIL=12

# Hard ceiling on reviews pulled per competitor (cost control).
# MAX_REVIEWS_PER_APP=200

# Sign-in -------------------------------------------------------------------

# The one account that may use this deployment. Leave both blank in local
# development to run without a login; in production, an unset pair locks the
# whole app instead of exposing it.
AUTH_USERNAME=
AUTH_PASSWORD=

# Key used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left unset it is derived from the username and password above, which
# means a password change signs out every existing session.
# AUTH_SECRET=

# Storage -------------------------------------------------------------------

# Future: PostgreSQL / Neon connection string for persisted research.
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
